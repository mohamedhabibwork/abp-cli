{
  "entity": "Product",
  "entityType": "FullAuditedAggregateRoot<Guid>",
  "attributes": [
    {
      "type": "string",
      "name": "Name",
      "required": true,
      "maxLength": 100
    },
    {
      "type": "Guid",
      "name": "CategoryId",
      "required": true,
      "filterable": true,
      "relation": {
        "kind": "reference",
        "entity": "Category",
        "inverse": "Products"
      }
    },
    {
      "type": "decimal",
      "name": "Price",
      "required": true
    }
  ]
}
